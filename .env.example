# Copy the lines below into apps/api/.dev.vars for local development. That file is not committed.
# Never put real secrets in this example file.

# Must be the address you open in the browser (the site), because the CSRF check compares the Origin header to it.
APP_URL=http://localhost:4321
# Prints sign-in links in the terminal instead of emailing them. Local development only.
MAIL_MODE=console
# Any long random text. Used to hash visitor IPs for the audit log.
IP_HASH_SECRET=change-me-to-something-random

# Cloudflare Turnstile secret key. Leave empty in local development (the check is skipped only when MAIL_MODE=console).
# In production it is required: without it, sign-ups are refused. For testing Cloudflare publishes dummy keys:
# always passes 1x0000000000000000000000000000000AA, always fails 2x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Optional: Google and GitHub sign-in. Create the apps yourself. Never paste these into chat or commit them.
# Redirect addresses to register: {APP_URL}/api/v1/auth/google/callback and {APP_URL}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Live site only: real sign-in email through Brevo (free plan, no card). Set MAIL_MODE=brevo.
# BREVO_API_KEY is a SECRET (wrangler secret put BREVO_API_KEY). The sender must be verified in Brevo.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=you@your-domain.example
